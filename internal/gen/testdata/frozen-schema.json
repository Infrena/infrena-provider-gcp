{
  "name": "tiny",
  "version": "v1",
  "rootUrl": "https://tiny.googleapis.com/",
  "servicePath": "",
  "schemas": {
    "Frozen": {
      "id": "Frozen",
      "type": "object",
      "properties": {
        "name": {"type": "string", "description": "The frozen name."},
        "value": {"type": "string", "description": "The frozen value."},
        "config": {
          "type": "object",
          "description": "A nested object, to check AllForceNew recurses into Fields.",
          "properties": {
            "mode": {"type": "string", "description": "The mode."},
            "computed": {"type": "string", "readOnly": true, "description": "[Output Only] server-computed; must stay Output, not ForceNew."}
          }
        },
        "tags": {
          "type": "array",
          "description": "An array of objects, to check AllForceNew recurses into Elem.Fields.",
          "items": {
            "type": "object",
            "properties": {
              "key": {"type": "string", "description": "The tag key."}
            }
          }
        }
      }
    },
    "Operation": {
      "id": "Operation",
      "type": "object",
      "properties": {"status": {"type": "string"}, "targetLink": {"type": "string"}}
    }
  },
  "resources": {
    "projects": {
      "resources": {
        "frozens": {
          "methods": {
            "insert": {
              "id": "tiny.projects.frozens.insert",
              "path": "projects/{project}/frozens",
              "httpMethod": "POST",
              "request": {"$ref": "Frozen"},
              "response": {"$ref": "Operation"}
            },
            "delete": {
              "id": "tiny.projects.frozens.delete",
              "path": "projects/{project}/frozens/{frozen}",
              "httpMethod": "DELETE",
              "response": {"$ref": "Operation"}
            },
            "list": {
              "id": "tiny.projects.frozens.list",
              "path": "projects/{project}/frozens",
              "httpMethod": "GET",
              "response": {"$ref": "Frozen"}
            }
          }
        }
      }
    }
  }
}
