#!/usr/bin/env bash
# Downloads the inputs the generator reads. Both land outside the build:
# schemas/ is gitignored, gen/mmv1/ is committed at a pinned commit.
#
# Nothing here runs at build time. The catalog is generated by hand and
# committed, so a build never reaches the network.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p schemas
echo "fetching the Discovery directory"
curl -fsS "https://discovery.googleapis.com/discovery/v1/apis" -o schemas/_directory.json

# Only the APIs the catalog covers. The full directory is 314 preferred APIs and
# most of them (AdSense, AdMob, Blogger) are not infrastructure.
#
# Each API's VERSION is pinned explicitly rather than taken from the
# directory's own "preferred" flag. "preferred" is Google's own opinion of
# which version client libraries should default to, not "the version whose
# resources match what our catalog wants" -- for `iam` it points at v2, the
# narrow Deny-Policies API, while v1 (ServiceAccount, Role) is the one this
# catalog actually needs and is not marked preferred at all. Trusting the flag
# here silently generates from the wrong API surface with no error anywhere.
apis=$(python3 - <<'PY'
import json, sys
d=json.load(open('schemas/_directory.json'))
pins={'compute':'v1','storage':'v1','container':'v1','sqladmin':'v1','iam':'v1',
 'cloudresourcemanager':'v3','dns':'v1','run':'v2','pubsub':'v1','redis':'v1',
 'cloudkms':'v1','secretmanager':'v1','artifactregistry':'v1','bigquery':'v2',
 'certificatemanager':'v1','cloudfunctions':'v2','spanner':'v1','file':'v1',
 'vpcaccess':'v1','networkservices':'v1','networksecurity':'v1','alloydb':'v1',
 'cloudscheduler':'v1','cloudtasks':'v2','eventarc':'v1','workflows':'v1',
 'memcache':'v1','apigateway':'v1','composer':'v1','dataproc':'v1',
 'bigtableadmin':'v2','firestore':'v1','monitoring':'v3','logging':'v2',
 'servicenetworking':'v1','cloudbuild':'v2','clouddeploy':'v1',
 'binaryauthorization':'v1','accesscontextmanager':'v1','cloudasset':'v1',
 'osconfig':'v2','notebooks':'v2'}
byname={}
for i in d['items']:
    if i['name'] in pins:
        byname.setdefault(i['name'], {})[i['version']] = i['discoveryRestUrl']
missing = [f"{name}:{version}" for name, version in pins.items() if version not in byname.get(name, {})]
if missing:
    print("pinned API version not in the Discovery directory: " + ", ".join(missing), file=sys.stderr)
    sys.exit(1)
for name, version in sorted(pins.items()):
    print(name, version, byname[name][version])
PY
)

while read -r name version url; do
  [ -z "$name" ] && continue
  echo "  $name $version"
  curl -fsS "$url" -o "schemas/${name}.json"
done <<< "$apis"

# magic-modules, pinned. Refuses to copy anything MPL (plan decision P4).
pin=$(cat gen/mmv1.lock)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git clone --quiet --filter=blob:none --sparse https://github.com/GoogleCloudPlatform/magic-modules.git "$tmp/mm"
git -C "$tmp/mm" sparse-checkout set mmv1/products
git -C "$tmp/mm" checkout --quiet "$pin"

# This check is deliberately redundant: `sparse-checkout set mmv1/products`
# above already keeps third_party/ and tools/ out of the working tree in cone
# mode, so $tmp/mm/$forbidden should never exist. Kept anyway, on purpose —
# the sparse-checkout scope is one line someone could widen later (to vendor
# another mmv1 subdirectory, say) without thinking about licensing, and this
# is what fails loudly if they do. A licence boundary is worth defence in
# depth even when the primary defence looks sufficient today.
for forbidden in mmv1/third_party tools; do
  if [ -e "$tmp/mm/$forbidden" ]; then
    echo "refusing to vendor $forbidden: it is MPL 2.0, not Apache 2.0" >&2
    exit 1
  fi
done

rm -rf gen/mmv1
mkdir -p gen/mmv1
# Copy ONLY the YAML files. A literal `cp -r` also vendors BUILD.bazel and
# anything else upstream keeps beside the resources, which breaks the yaml-only
# rule even though those files are Apache 2.0 like the rest of products/.
# -m 644 is not cosmetic. GNU install defaults to 755, so without it every
# vendored YAML arrives executable while the committed copies are 644, and
# `git status` reports 1129 modified files with zero content changed after a
# run that vendored the same pinned commit. That is noise on its own and it
# would swamp the weekly regeneration PR, where the whole point is that a
# reviewer can see what actually drifted. Data files are not executable.
(cd "$tmp/mm/mmv1/products" && find . -name '*.yaml' -exec install -D -m 644 {} "$OLDPWD/gen/mmv1/products/{}" \;)
echo "vendored magic-modules at $pin: $(find gen/mmv1 -name '*.yaml' ! -name product.yaml | wc -l) resources"
